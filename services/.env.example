# Example only: NEVER share your real .env or add it to Git.
POSTGRES_DB=overthink_app
POSTGRES_USER=overthink_app
POSTGRES_PASSWORD=REPLACE_WITH_YOUR_PRIVATE_PASSWORD
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://overthink_app:REPLACE_WITH_YOUR_PRIVATE_PASSWORD@127.0.0.1:5432/overthink_app

ENV=dev
# Generate each secret independently:
# py -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_PEPPER_SECRET=REPLACE_WITH_A_DIFFERENT_32+_CHARACTER_SECRET

APP_BASE_URL=http://127.0.0.1:8000

EMAIL_BACKEND=resend
RESEND_API_KEY=re_REPLACE_ME
# onboarding@resend.dev is suitable for initial Resend testing. For real users,
# use a sender address on a domain verified in your Resend account.
RESEND_FROM=Overthink <onboarding@resend.dev>

VERIFICATION_CODE_MINUTES=10
VERIFICATION_CODE_MAX_ATTEMPTS=5
VERIFICATION_RESEND_SECONDS=60
VERIFICATION_SEND_WINDOW_MINUTES=60
VERIFICATION_EMAIL_SEND_LIMIT=5
VERIFICATION_IP_SEND_LIMIT=20
VERIFICATION_ATTEMPT_WINDOW_MINUTES=15
VERIFICATION_EMAIL_ATTEMPT_LIMIT=10
VERIFICATION_IP_ATTEMPT_LIMIT=30

PRIVACY_POLICY_VERSION=2026-10-01
